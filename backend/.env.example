# Copy this file to .env and adjust CORS_ORIGINS for the frontend's local web server.
APP_NAME=MindSense Emotion Screening API
MODEL_PATH=models/mindsense_emotion_model.keras
FACE_DETECTION_CONFIDENCE=0.5
MAX_IMAGE_BYTES=10485760
MAX_SEQUENCE_FRAMES=30
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501
CORS_ALLOW_CREDENTIALS=false
